# ==========================================
# PAWCONNECT ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to Git.
# ==========================================

# ------------------------------------------
# CLERK AUTHENTICATION (Get from https://dashboard.clerk.com)
# ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------
# SUPABASE DATABASE & STORAGE (Get from https://supabase.com/dashboard)
# ------------------------------------------
# Project URL — safe to expose publicly
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (formerly anon/public key) — safe to expose publicly
# Dashboard → Project Settings → API → "Project API keys" → anon / publishable
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_publishable

# Secret key (formerly service_role key) — NEVER expose to the browser
# Dashboard → Project Settings → API → "Project API keys" → service_role / secret
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_secret
